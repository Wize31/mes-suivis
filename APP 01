/* --------------------------------- small UI --------------------------------- */

function ConfirmButton({ label, confirmLabel = "Confirmer ?", onConfirm, className, icon }) {
  const [confirming, setConfirming] = useState(false);
  const timer = useRef(null);
  useEffect(() => () => timer.current && clearTimeout(timer.current), []);
  return (
    <button
      type="button"
      className={`tk-confirm-btn ${confirming ? "is-confirming" : ""} ${className || ""}`}
      onClick={(e) => {
        e.stopPropagation();
        if (!confirming) {
          setConfirming(true);
          timer.current = setTimeout(() => setConfirming(false), 2800);
        } else {
          clearTimeout(timer.current);
          setConfirming(false);
          onConfirm();
        }
      }}
      title={label}
    >
      {confirming ? confirmLabel : icon}
    </button>
  );
}

function ColorSwatchPicker({ value, onChange }) {
  const [open, setOpen] = useState(false);
  return (
    <div className="tk-swatch-wrap">
      <button type="button" className="tk-swatch" style={{ background: value }} onClick={() => setOpen((o) => !o)} />
      {open && (
        <div className="tk-swatch-pop">
          {PALETTE.map((c) => (
            <button key={c} type="button" className="tk-swatch-opt" style={{ background: c }} onClick={() => { onChange(c); setOpen(false); }} />
          ))}
          <input type="color" value={value} onChange={(e) => onChange(e.target.value)} className="tk-color-input" />
        </div>
      )}
    </div>
  );
}

/* -------------------------------- dot helpers -------------------------------- */

function dotsForValue(module, value) {
  if (value === undefined || value === null) return [];
  if (module.type === "choice") {
    const opt = (module.options || []).find((o) => o.id === value);
    return opt ? [opt.color] : [];
  }
  if (module.type === "multiselect") {
    const arr = Array.isArray(value) ? value : [];
    return arr.map((id) => (module.options || []).find((o) => o.id === id)?.color).filter(Boolean);
  }
  if (module.type === "scale") {
    if (typeof value !== "number") return [];
    return [scaleColorAt(module.anchors || [], value)];
  }
  if (module.type === "composite") {
    const hasAny = module.fields?.some((f) => value?.[f.id] !== undefined && value?.[f.id] !== "");
    return hasAny ? [module.color] : [];
  }
  if (module.type === "text") {
    return value && value.trim() ? [module.color] : [];
  }
  return [];
}

function summarizeValue(module, value) {
  if (value === undefined || value === null) return "—";
  if (module.type === "choice") {
    const opt = (module.options || []).find((o) => o.id === value);
    return opt ? opt.label : "—";
  }
  if (module.type === "multiselect") {
    const arr = Array.isArray(value) ? value : [];
    if (!arr.length) return "—";
    return arr.map((id) => (module.options || []).find((o) => o.id === id)?.label).filter(Boolean).join(", ");
  }
  if (module.type === "scale") {
    if (typeof value !== "number") return "—";
    return `${value}/10 · ${scaleLabelAt(module.anchors || [], value)}`;
  }
  if (module.type === "composite") {
    const parts = (module.fields || []).map((f) => (value?.[f.id] !== undefined && value?.[f.id] !== "" ? `${value[f.id]}${f.unit || ""}` : null)).filter(Boolean);
    return parts.length ? parts.join(" · ") : "—";
  }
  if (module.type === "text") {
    if (!value || !value.trim()) return "—";
    return value.length > 60 ? value.slice(0, 60) + "…" : value;
  }
  return "—";
}

function computeComposite(module, value) {
  const scope = {};
  (module.fields || []).forEach((f) => { scope[f.id] = parseFloat(value?.[f.id]) || 0; });
  const results = {};
  (module.computed || []).forEach((c) => {
    try { results[c.id] = math.evaluate(c.formula || "0", scope); }
    catch (e) { results[c.id] = null; }
  });
  return results;
}
