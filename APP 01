/* ---------------------------------- Today ------------------------------------ */

function ModuleCard({ module, value, onChange, expanded, onToggle }) {
  const dots = dotsForValue(module, value);
  return (
    <div className={`tk-card ${expanded ? "is-open" : ""}`} style={{ "--card-color": module.color }}>
      <button type="button" className="tk-card-head" onClick={onToggle}>
        <span className="tk-card-dot" />
        <span className="tk-card-titles">
          <span className="tk-card-title">{module.title}</span>
          {module.subtitle && <span className="tk-card-subtitle">{module.subtitle}</span>}
        </span>
        <span className="tk-card-summary">
          {dots.length > 0 && (
            <span className="tk-mini-dots">
              {dots.slice(0, 5).map((c, i) => <span key={i} className="tk-mini-dot" style={{ background: c }} />)}
            </span>
          )}
          <span className="tk-card-summary-text">{summarizeValue(module, value)}</span>
        </span>
      </button>
      {expanded && (
        <div className="tk-card-body">
          <ValueInput module={module} value={value} onChange={onChange} />
        </div>
      )}
    </div>
  );
}

function TodayView({ modules, date, setDate, dayData, onValueChange }) {
  const [expandedId, setExpandedId] = useState(null);
  const isToday = sameDay(date, new Date());
  return (
    <div className="tk-today">
      <div className="tk-date-nav">
        <button type="button" className="tk-icon-btn" onClick={() => setDate(addDays(date, -1))}><ChevronLeft size={18} /></button>
        <div className="tk-date-label">
          <span>{DAY_NAMES[(date.getDay() + 6) % 7]} {date.getDate()} {MONTH_NAMES[date.getMonth()]} {date.getFullYear()}</span>
          {!isToday && <button type="button" className="tk-today-btn" onClick={() => setDate(new Date())}>Aujourd'hui</button>}
        </div>
        <button type="button" className="tk-icon-btn" onClick={() => setDate(addDays(date, 1))}><ChevronRight size={18} /></button>
      </div>

      {modules.length === 0 ? (
        <div className="tk-empty">Aucun suivi encore. Ajoute-en un dans l'onglet Réglages.</div>
      ) : (
        <div className="tk-card-list">
          {modules.map((m) => (
            <ModuleCard
              key={m.id}
