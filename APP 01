function SettingsView({ modules, onModulesChange, project, onProjectChange, onDeleteProject }) {
  const [editingId, setEditingId] = useState(null);

  const updateModule = (id, patch) => onModulesChange(modules.map((m) => (m.id === id ? patch : m)));
  const deleteModule = (id) => { onModulesChange(modules.filter((m) => m.id !== id)); setEditingId(null); };
