          />
        )}
      </div>
    </div>
  );
}

export default function App() {
  const [projects, setProjects] = useState(null);
  const [selectedId, setSelectedId] = useState(null);

  useEffect(() => {
    (async () => {
      const raw = await sGet("projects");
      if (raw) {
        setProjects(JSON.parse(raw));
      } else {
        const perso = { id: uid("proj"), name: "Perso", emoji: "🌷", color: "#8C7AE6" };
        await sSet("projects", JSON.stringify([perso]));
        await sSet(`modules:${perso.id}`, JSON.stringify(defaultPersoModules()));
        setProjects([perso]);
      }
    })();
  }, []);

  const persistProjects = (next) => { setProjects(next); sSet("projects", JSON.stringify(next)); };

  const createProject = async (p) => {
    const proj = { id: uid("proj"), name: p.name, emoji: p.emoji, color: p.color };
    const next = [...projects, proj];
    persistProjects(next);
    await sSet(`modules:${proj.id}`, JSON.stringify([]));
  };

  const editProject = (p) => persistProjects(projects.map((x) => (x.id === p.id ? { ...x, ...p } : x)));

  const deleteProject = async (id) => {
    persistProjects(projects.filter((x) => x.id !== id));
    await sDelete(`modules:${id}`);
    if (selectedId === id) setSelectedId(null);
  };

  const patchSelected = (patch) => {
    persistProjects(projects.map((x) => (x.id === selectedId ? { ...x, ...patch } : x)));
  };

  if (projects === null) {
    return (
      <div className="tk-app">
        <style>{CSS}</style>
        <div className="tk-loading">Chargement de tes suivis…</div>
      </div>
    );
  }

  const selected = projects.find((p) => p.id === selectedId);

  return (
    <div className="tk-app">
      <style>{CSS}</style>
      {!selected && (
        <HomeScreen
          projects={projects}
          onOpen={(p) => setSelectedId(p.id)}
          onCreate={createProject}
          onEdit={editProject}
          onDelete={deleteProject}
        />
      )}
      {selected && (
        <ProjectShell
          project={selected}
          onBack={() => setSelectedId(null)}
          onProjectPatch={patchSelected}
          onDeleteProject={() => deleteProject(selected.id)}
        />
      )}
    </div>
  );
}
