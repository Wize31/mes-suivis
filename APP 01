      {range === "mois" && <MonthView modules={modules} anchorDate={date} getDayData={getDayData} onPickDate={pick} monthOffset={monthOffset} setMonthOffset={setMonthOffset} />}
      {range === "année" && <YearView modules={modules} anchorDate={date} getDayData={getDayData} onPickDate={pick} yearOffset={yearOffset} setYearOffset={setYearOffset} />}
    </div>
  );
}
