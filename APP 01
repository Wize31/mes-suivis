        <button type="button" className={`tk-tab ${tab === "history" ? "is-active" : ""}`} onClick={() => setTab("history")}><CalendarRange size={16} /> Historique</button>
        <button type="button" className={`tk-tab ${tab === "settings" ? "is-active" : ""}`} onClick={() => setTab("settings")}><Settings2 size={16} /> Réglages</button>
      </div>

      <div className="tk-tab-content">
        {tab === "today" && (
          <TodayView modules={modules} date={date} setDate={setDate} dayData={getDayData(date)} onValueChange={onValueChange} />
        )}
        {tab === "history" && (
          <HistoryView modules={modules} date={date} setDate={setDate} setTab={setTab} getDayData={getDayData} />
        )}
        {tab === "settings" && (
          <SettingsView
            modules={modules} onModulesChange={saveModules}
            project={project} onProjectChange={onProjectPatch}
