              onToggle={() => setExpandedId(expandedId === m.id ? null : m.id)}
              onChange={(v) => onValueChange(m.id, v)}
            />
          ))}
        </div>
      )}
    </div>
  );
}

/* --------------------------------- History ------------------------------------ */

function DayCell({ date, inMonth, isToday, modules, dayData, onClick, size }) {
  const allDots = [];
  modules.forEach((m) => dotsForValue(m, dayData?.[m.id]).forEach((c) => allDots.push(c)));
  return (
    <button
      type="button"
      className={`tk-day-cell ${size === "sm" ? "sm" : ""} ${inMonth === false ? "faded" : ""} ${isToday ? "is-today" : ""}`}
      onClick={onClick}
    >
      <span className="tk-day-num">{date.getDate()}</span>
      <span className="tk-day-dots">
        {allDots.slice(0, 6).map((c, i) => <span key={i} className="tk-mini-dot" style={{ background: c }} />)}
        {allDots.length > 6 && <span className="tk-day-more">+{allDots.length - 6}</span>}
      </span>
    </button>
  );
}

function WeekView({ modules, anchorDate, getDayData, onPickDate, weekOffset, setWeekOffset }) {
  const start = addDays(startOfWeek(anchorDate), weekOffset * 7);
  const days = Array.from({ length: 7 }, (_, i) => addDays(start, i));
  const today = new Date();
  return (
    <div className="tk-week">
      <div className="tk-range-nav">
        <button type="button" className="tk-icon-btn" onClick={() => setWeekOffset((w) => w - 1)}><ChevronLeft size={16} /></button>
        <span>{days[0].getDate()} {MONTH_NAMES[days[0].getMonth()].slice(0,3)} — {days[6].getDate()} {MONTH_NAMES[days[6].getMonth()].slice(0,3)} {days[6].getFullYear()}</span>
        <button type="button" className="tk-icon-btn" onClick={() => setWeekOffset((w) => w + 1)}><ChevronRight size={16} /></button>
      </div>
      <div className="tk-week-grid">
        {days.map((d) => (
          <div key={d.toISOString()} className="tk-week-col">
            <div className="tk-week-day-name">{DAY_NAMES[(d.getDay() + 6) % 7]}</div>
            <DayCell date={d} isToday={sameDay(d, today)} modules={modules} dayData={getDayData(d)} onClick={() => onPickDate(d)} />
          </div>
        ))}
      </div>
    </div>
  );
}

function MonthView({ modules, anchorDate, getDayData, onPickDate, monthOffset, setMonthOffset }) {
  const base = new Date(anchorDate.getFullYear(), anchorDate.getMonth() + monthOffset, 1);
  const first = startOfMonth(base);
  const gridStart = startOfWeek(first);
  const totalDays = daysInMonth(base);
  const lastDay = new Date(base.getFullYear(), base.getMonth(), totalDays);
  const gridEnd = addDays(startOfWeek(lastDay), 6);
  const cells = [];
  let cur = new Date(gridStart);
  while (cur <= gridEnd) { cells.push(new Date(cur)); cur = addDays(cur, 1); }
  const today = new Date();
  return (
    <div className="tk-month">
      <div className="tk-range-nav">
        <button type="button" className="tk-icon-btn" onClick={() => setMonthOffset((m) => m - 1)}><ChevronLeft size={16} /></button>
        <span>{MONTH_NAMES[base.getMonth()]} {base.getFullYear()}</span>
        <button type="button" className="tk-icon-btn" onClick={() => setMonthOffset((m) => m + 1)}><ChevronRight size={16} /></button>
      </div>
      <div className="tk-month-weekdays">{DAY_NAMES.map((n) => <span key={n}>{n}</span>)}</div>
      <div className="tk-month-grid">
        {cells.map((d) => (
          <DayCell
            key={d.toISOString()} date={d} inMonth={d.getMonth() === base.getMonth()}
            isToday={sameDay(d, today)} modules={modules} dayData={getDayData(d)}
            onClick={() => onPickDate(d)} size="sm"
          />
        ))}
      </div>
    </div>
  );
}

function YearStats({ modules, year, getDayData }) {
  const stats = modules.map((m) => {
    let daysWithData = 0;
    if (m.type === "scale") {
      let sum = 0, count = 0;
      for (let mo = 0; mo < 12; mo++) {
        const dim = new Date(year, mo + 1, 0).getDate();
        for (let d = 1; d <= dim; d++) {
          const v = getDayData(new Date(year, mo, d))[m.id];
          if (typeof v === "number") { sum += v; count++; }
        }
      }
      return { module: m, kind: "avg", value: count ? (sum / count).toFixed(1) : "—", count };
    }
    if (m.type === "composite") {
      const totals = {};
      (m.fields || []).forEach((f) => (totals[f.id] = 0));
      (m.computed || []).forEach((c) => (totals[c.id] = 0));
      let count = 0;
      for (let mo = 0; mo < 12; mo++) {
        const dim = new Date(year, mo + 1, 0).getDate();
        for (let d = 1; d <= dim; d++) {
          const v = getDayData(new Date(year, mo, d))[m.id];
          if (v) {
            count++;
            (m.fields || []).forEach((f) => { totals[f.id] += parseFloat(v[f.id]) || 0; });
            const comp = computeComposite(m, v);
            (m.computed || []).forEach((c) => { totals[c.id] += comp[c.id] || 0; });
          }
        }
      }
      return { module: m, kind: "sum", totals, count };
    }
    if (m.type === "choice" || m.type === "multiselect") {
      const counts = {};
      (m.options || []).forEach((o) => (counts[o.id] = 0));
      let count = 0;
      for (let mo = 0; mo < 12; mo++) {
        const dim = new Date(year, mo + 1, 0).getDate();
        for (let d = 1; d <= dim; d++) {
          const v = getDayData(new Date(year, mo, d))[m.id];
          if (v) {
            count++;
            if (Array.isArray(v)) v.forEach((id) => { counts[id] = (counts[id] || 0) + 1; });
            else counts[v] = (counts[v] || 0) + 1;
          }
        }
      }
      return { module: m, kind: "freq", counts, count };
    }
    if (m.type === "text") {
      let count = 0;
      for (let mo = 0; mo < 12; mo++) {
        const dim = new Date(year, mo + 1, 0).getDate();
        for (let d = 1; d <= dim; d++) {
          const v = getDayData(new Date(year, mo, d))[m.id];
          if (v && v.trim()) count++;
        }
      }
      return { module: m, kind: "count", count };
    }
    return { module: m, kind: "none", count: 0 };
  });

  return (
    <div className="tk-year-stats">
      {stats.map(({ module: m, kind, ...s }) => (
        <div key={m.id} className="tk-stat-card" style={{ "--card-color": m.color }}>
          <div className="tk-stat-title"><span className="tk-card-dot" />{m.title}</div>
          {kind === "avg" && <div className="tk-stat-body">Moyenne : <strong>{s.value}/10</strong> <span className="tk-stat-sub">({s.count} jours notés)</span></div>}
          {kind === "sum" && (
            <div className="tk-stat-body">
              {[...(m.fields || []), ...(m.computed || [])].map((f) => (
                <div key={f.id} className="tk-stat-line"><span>{f.label}</span><strong>{Math.round((s.totals[f.id] || 0) * 100) / 100}{f.unit || ""}</strong></div>
              ))}
              <span className="tk-stat-sub">{s.count} jours enregistrés</span>
            </div>
          )}
          {kind === "freq" && (
            <div className="tk-stat-body">
              {(m.options || []).filter((o) => s.counts[o.id] > 0).sort((a, b) => s.counts[b.id] - s.counts[a.id]).map((o) => (
                <div key={o.id} className="tk-stat-line"><span><span className="tk-mini-dot" style={{ background: o.color }} /> {o.label}</span><strong>{s.counts[o.id]}</strong></div>
              ))}
              {s.count === 0 && <span className="tk-stat-sub">Pas encore de données</span>}
            </div>
          )}
          {kind === "count" && <div className="tk-stat-body">{s.count} jours avec une note</div>}
        </div>
      ))}
    </div>
  );
}

function YearView({ modules, anchorDate, getDayData, onPickDate, yearOffset, setYearOffset }) {
  const year = anchorDate.getFullYear() + yearOffset;
  const today = new Date();
  return (
    <div className="tk-year">
      <div className="tk-range-nav">
        <button type="button" className="tk-icon-btn" onClick={() => setYearOffset((y) => y - 1)}><ChevronLeft size={16} /></button>
        <span>{year}</span>
        <button type="button" className="tk-icon-btn" onClick={() => setYearOffset((y) => y + 1)}><ChevronRight size={16} /></button>
      </div>
      <div className="tk-year-months">
        {Array.from({ length: 12 }, (_, mo) => {
          const base = new Date(year, mo, 1);
          const dim = daysInMonth(base);
          return (
            <div key={mo} className="tk-year-month">
              <div className="tk-year-month-title">{MONTH_NAMES[mo]}</div>
              <div className="tk-year-month-grid">
                {Array.from({ length: dim }, (_, i) => {
                  const d = new Date(year, mo, i + 1);
                  const dots = [];
                  modules.forEach((m) => dotsForValue(m, getDayData(d)[m.id]).forEach((c) => dots.push(c)));
                  return (
                    <button
                      key={i} type="button" onClick={() => onPickDate(d)}
                      className={`tk-year-day ${sameDay(d, today) ? "is-today" : ""}`}
                      style={{ background: dots[0] || "var(--tk-border)" }}
                      title={`${i + 1} ${MONTH_NAMES[mo]}`}
                    />
                  );
                })}
              </div>
            </div>
          );
        })}
      </div>
      <YearStats modules={modules} year={year} getDayData={getDayData} />
    </div>
  );
}

function HistoryView({ modules, date, setDate, setTab, getDayData }) {
  const [range, setRange] = useState("semaine");
