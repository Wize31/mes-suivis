/* ----------------------------------- App --------------------------------------- */

function ProjectShell({ project, onBack, onProjectPatch, onDeleteProject }) {
  const [tab, setTab] = useState("today");
  const [date, setDate] = useState(new Date());
  const [modules, setModules] = useState(null);
  const [monthsCache, setMonthsCache] = useState({});
  const loadingMonths = useRef(new Set());
  const saveTimers = useRef({});

  useEffect(() => {
    let alive = true;
    (async () => {
      const raw = await sGet(`modules:${project.id}`);
      if (alive) setModules(raw ? JSON.parse(raw) : []);
    })();
    return () => { alive = false; };
  }, [project.id]);

  const ensureMonth = useCallback((mk) => {
    if (monthsCache[mk] !== undefined || loadingMonths.current.has(mk)) return;
    loadingMonths.current.add(mk);
    (async () => {
      const raw = await sGet(`entries:${project.id}:${mk}`);
      setMonthsCache((prev) => ({ ...prev, [mk]: raw ? JSON.parse(raw) : {} }));
      loadingMonths.current.delete(mk);
    })();
  }, [project.id, monthsCache]);

  useEffect(() => { ensureMonth(monthKeyOf(date)); }, [date, ensureMonth]);

  // preload surrounding months for smoother week/month/year browsing
  useEffect(() => {
    const d = new Date();
    for (let i = -13; i <= 13; i++) {
      const probe = new Date(d.getFullYear(), d.getMonth() + i, 1);
      ensureMonth(monthKeyOf(probe));
    }
  }, [ensureMonth]);

  const getDayData = useCallback((d) => {
    const mk = monthKeyOf(d), dk = dayKeyOf(d);
    return monthsCache[mk]?.[dk] || {};
  }, [monthsCache]);

  const scheduleSaveMonth = (mk, monthObj) => {
    if (saveTimers.current[mk]) clearTimeout(saveTimers.current[mk]);
    saveTimers.current[mk] = setTimeout(() => { sSet(`entries:${project.id}:${mk}`, JSON.stringify(monthObj)); }, 500);
  };

  const onValueChange = (moduleId, value) => {
    const mk = monthKeyOf(date), dk = dayKeyOf(date);
    setMonthsCache((prev) => {
      const monthObj = { ...(prev[mk] || {}) };
      const dayObj = { ...(monthObj[dk] || {}) };
      dayObj[moduleId] = value;
      monthObj[dk] = dayObj;
      scheduleSaveMonth(mk, monthObj);
      return { ...prev, [mk]: monthObj };
    });
  };

  const saveModules = (next) => {
    setModules(next);
    sSet(`modules:${project.id}`, JSON.stringify(next));
  };

  if (modules === null) return <div className="tk-loading">Chargement…</div>;

  return (
    <div className="tk-project-shell">
